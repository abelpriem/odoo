<odoo>
  <data>
    <record id="action_students" model="ir.actions.act_window">
      <field name="name">Students</field>
      <field name="res_model">students.info</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="view_list_students" model="ir.ui.view">
      <field name="name">Students</field>
      <field name="model">students.info</field>
      <field name="arch" type="xml">
        <list>
          <!-- <field name="nombre" />
          <field name="apellido" />
          <field name="edad" />
          <field name="email" /> 
          <field name="curso" />-->
          <field name="estudiante_id" />
          <field name="curso_id" />
          <field name="estado_calificacion" />
        </list>
      </field>
    </record>

    <record id="action_cursos" model="ir.actions.act_window">
      <field name="name">Cursos</field>
      <field name="res_model">cursos.students</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="view_list_cursos" model="ir.ui.view">
      <field name="name">Cursos</field>
      <field name="model">cursos.students</field>
      <field name="arch" type="xml">
        <list>
          <field name="nombre_curso" />
        </list>
      </field>
    </record>

    <menuitem
      id="menu_root_students"
      name="Students"
      sequence="10"
      action="action_students"/>

    <menuitem id="menu_students" name="Estudiantes" parent="menu_root_students" action="action_students" />
    <menuitem id="menu_cursos" name="Cursos" parent="menu_root_students" action="action_cursos" />
  </data>
</odoo>
