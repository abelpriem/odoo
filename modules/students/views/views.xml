<odoo>
  <data>

    <record id="view_list_students" model="ir.ui.view">
      <field name="name">students.info.list</field>
      <field name="model">students.info</field>
      <field name="arch" type="xml">
        <list>
          <field name="estudiante_id" />
          <field name="curso_id" />
          <field name="estado_calificacion" />
        </list>
      </field>
    </record>

    <record id="view_list_cursos" model="ir.ui.view">
      <field name="name">cursos.stundets.list</field>
      <field name="model">cursos.students</field>
      <field name="arch" type="xml">
        <list>
          <field name="nombre_curso" />
          <field name="profesor_id" />
        </list>
      </field>
    </record>
    <record id="view_list_asignaturas" model="ir.ui.view">
      <field name="name">students.asignaturas.list</field>
      <field name="model">students.asignaturas</field>
      <field name="arch" type="xml">
        <list>
          <field name="nombre_asignatura" />
          <field name="profesor_id" />
        </list>
      </field>
    </record>

    <record id="view_list_calificaciones" model="ir.ui.view">
      <field name="name">students.calificaciones.list</field>
      <field name="model">students.calificaciones</field>
      <field name="arch" type="xml">
        <list>
          <field name="estudiante_id" />
          <field name="asignatura_id" />
          <field name="calificacion" />
          <field name="estado" />
        </list>
      </field>
    </record>

    <record id="view_form_students" model="ir.ui.view">
      <field name="model">students.info</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <field name="estado_calificacion" widget="statusbar" options="{'clickable': 1}"/>
            <button type="object" string="Aprobar" name="aprobar" />
            <button type="object" string="Suspender" name="suspender" />
          </header>
          <sheet>
            <group>
              <group>
                <field name="estudiante_id" />
                <field name="curso_id" />
                <field name="esta_aprobado" />
              </group>

              <group>
                <field name="country_id" />
                <field name="tag_id" widget="many2many_tags"/>
                <field name="address" widget="url"/>
                <field name="edad" />
              </group>
            </group>

            <notebook>
              <page name="calification" string="Calificaciones">
                <field name="calificaciones_ids">
                  <list editable="bottom">
                    <field name="asignatura_id" />
                    <field name="profesor_id" string="Calificado por" />
                    <field name="calificacion" />
                    <field name="estado" string="Estado" />
                  </list>
                </field>
              </page>

              <page name="Notas de Acta" >
                <field name="acta" />
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

     <record id="view_form_cursos" model="ir.ui.view">
      <field name="model">cursos.students</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="nombre_curso"/>
              <field name="profesor_id" />
            </group>
            <notebook>
              <page string="Asignaturas">
                <field name="asignatura_ids" widget="many2many_tags"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_form_asignaturas" model="ir.ui.view">
      <field name="model">students.asignaturas</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="nombre_asignatura"/>
              <field name="profesor_id" />
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_form_calificaciones" model="ir.ui.view">
      <field name="model">students.calificaciones</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="estudiante_id"/>
              <field name="asignatura_id"/>
              <field name="calificacion"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="wizard_view_aprobar_form" model="ir.ui.view">
      <field name="name">Aprobar</field>
      <field name="model">wizard.calificaciones</field>
      <field name="arch" type="xml">
        <form>
          <group>
            <field name="estudiante_id" readonly="1"/>
            <field name="acta" />
          </group>

          <footer>
            <button type="object" name="aprobado" string="Aprobar" class="btn btn-primary" />
            <button special="cancel" string="Cancelar" />
          </footer>
        </form>
      </field>
    </record>

    <record id="wizard_view_suspender_form" model="ir.ui.view">
      <field name="name">Suspender</field>
      <field name="model">wizard.calificaciones</field>
      <field name="arch" type="xml">
        <form>
          <group>
            <field name="estudiante_id" readonly="1"/>
            <field name="acta" />
          </group>

          <footer>
            <button type="object" name="suspender" string="Suspender" class="btn btn-primary" />
            <button special="cancel" string="Cancelar" />
          </footer>
        </form>
      </field>
    </record>

    <record id="inherit_res_partner" model="ir.ui.view">
      <field name="name">inherit_res_partner</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"></field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='category_id']" position="after">
          <field name="es_profesor" />
        </xpath>
      </field>
    </record>
    <record id="action_students" model="ir.actions.act_window">
      <field name="name">Estudiantes</field>
      <field name="res_model">students.info</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_cursos" model="ir.actions.act_window">
      <field name="name">Cursos</field>
      <field name="res_model">cursos.students</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_asignaturas" model="ir.actions.act_window">
      <field name="name">Asignaturas</field>
      <field name="res_model">students.asignaturas</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_profesores" model="ir.actions.act_window">
      <field name="name">Profesores</field>
      <field name="res_model">students.profesores</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_calificaciones" model="ir.actions.act_window">
      <field name="name">Calificaciones</field>
      <field name="res_model">students.calificaciones</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_root_students" name="Students" sequence="10" groups="students.students_group_access"/>

    <menuitem id="menu_students" name="Estudiantes" parent="menu_root_students" action="action_students" sequence="10" />
    <menuitem id="menu_cursos" name="Cursos" parent="menu_root_students" action="action_cursos" sequence="20"/>
    <menuitem id="menu_asignaturas" name="Asignaturas" parent="menu_root_students" action="action_asignaturas" sequence="30"/>
    <menuitem id="menu_profesores" name="Profesores" parent="menu_root_students" action="action_profesores" sequence="40"/>
    <menuitem id="menu_calificaciones" name="Calificaciones" parent="menu_root_students" action="action_calificaciones" sequence="50"/>
  </data>
</odoo>